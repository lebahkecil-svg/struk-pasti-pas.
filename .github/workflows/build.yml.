name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Ekstrak project dari ZIP
        run: unzip -q "$(ls *.zip | head -1)" -d proj
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
          build-root-directory: proj/StrukPastiPas
      - name: Build APK
        working-directory: proj/StrukPastiPas
        run: gradle assembleDebug --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: StrukPastiPas-APK
          path: proj/StrukPastiPas/app/build/outputs/apk/debug/app-debug.apk
